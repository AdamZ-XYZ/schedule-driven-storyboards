OPC_BASE_URL=https://{tenant}.oraclecloud.com/api/restapi/v1
OPC_TOKEN_URL=https://{tenant}.oraclecloud.com/oauth/token
OPC_CLIENT_ID=your-client-id
OPC_CLIENT_SECRET=your-client-secret
OPC_PROJECT_ID=your-project-id

# Session baseline grace period in minutes (default: 10)
SESSION_GRACE_MINUTES=10

# Cache backend: "memory" (default) or "sqlite"
CACHE_BACKEND=memory

# MCP transport: "stdio" (default) or "sse"
TRANSPORT=stdio

LOG_LEVEL=INFO
